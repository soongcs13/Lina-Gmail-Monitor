# Copy to .env and fill in. Never commit the real .env.

# Gmail OAuth (Desktop app credentials.json must sit at GMAIL_CREDENTIALS_PATH,
# default: project root). token.json is generated on first run.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_WATCHED_ADDRESS=lina@palad.co

# Notion internal integration token ("Lina Gmail Monitor")
NOTION_TOKEN=

# Notion database IDs. BD_DATABASE_ID is confirmed against the live
# workspace (the ID in the original brief was actually a page, not the
# database) — override only if it differs in your workspace.
PIPELINE_DB_ID=17e6d34b-aa60-438d-b2fe-5b383d566a36
BD_DATABASE_ID=3215734a-d555-80f7-a2a1-c4de6375a2ab

# Pipeline DB property names — confirmed against the live schema on
# 2026-08-07 via `python main.py --schema-check`. Re-check if the schema
# changes.
PIPELINE_PROP_EMAIL=Email
PIPELINE_PROP_COMPANY=Name
PIPELINE_PROP_STATUS=Status
PIPELINE_PROP_ACTION_LOG=Action Log

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Slack — leave empty to degrade gracefully (digest logged locally instead)
SLACK_WEBHOOK_URL=
